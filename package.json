{
  "name": "equip-nav",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:web": "npm run dev --workspace=apps/web",
    "prepare-osrm": "node scripts/prepare-osrm.js",
    "build-portable": "node scripts/build-portable.js"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
